{
  "name": "resources2crate",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser RO-Crate builder for a local folder — build + preview (JSON, xlsx, html) via the ro-crate libraries.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 5000",
    "test": "node scripts/run-tests.mjs",
    "test:hooks": "node tests/test-hooks.mjs",
    "test:crate": "node tests/test-crate.mjs",
    "test:edit-crate": "node tests/test-edit-crate.mjs",
    "test:place-merge": "node tests/test-place-merge.mjs",
    "test:top-level-folders": "node tests/test-top-level-folders.mjs",
    "test:default-profile": "node tests/test-default-profile.mjs",
    "update:austlang": "node scripts/update-austlang-data.mjs",
    "generate:chordprobook-bundle": "node scripts/bundle-chordprobook-for-browser.mjs",
    "fix:st-directive": "node scripts/fix-st-directive.mjs",
    "build:songbook": "node src/plugins/chordpro-input/build-songbook.mjs"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "chordprobook": "file:../chordprobook",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "ro-crate": "^3.7.2",
    "ro-crate-excel": "^1.2.1",
    "ro-crate-masp": "github:Language-Research-Technology/ro-crate-masp",
    "ro-crate-static-site": "github:crate-works/ro-crate-static-site#main"
  },
  "devDependencies": {
    "@describo/data-packs": "^0.13.1",
    "vite": "^5.4.0",
    "vite-plugin-node-polyfills": "^0.22.0",
    "yaml": "^2.9.0"
  }
}
